<?xml version="1.0" encoding="UTF-8"?>
<!--
  YumoCut's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.11 -d Root=C:\...\YumoCut
              -d Stage=C:\...\stage\YumoCut-0.2.11-windows-x86_64
              -o stage\YumoCut-0.2.11-windows-x86_64.msi assets\windows\concat.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="YumoCut"
           Manufacturer="YumoCut contributors"
           Version="$(var.Version)"
           UpgradeCode="9A2F6C41-53D8-4E7B-B960-2D84A71C5F39"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of YumoCut is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="yumocut.ico" SourceFile="$(var.Root)\assets\icons\yumocut.ico" />
    <Property Id="ARPPRODUCTICON" Value="yumocut.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Beau1314/YumoCut" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="YumoCut" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="YumoCut" />
    </StandardDirectory>

    <Feature Id="Main" Title="YumoCut" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="C35E8A74-91D2-4F6B-A847-5B0D2E69C13A">
      <Shortcut Id="StartMenuShortcut"
                Name="YumoCut"
                Description="Video editor"
                Target="[INSTALLFOLDER]concat.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="yumocut.ico" />
      <!-- The way in when a graphics driver draws the window as coloured
           squares: it turns off Settings > General > Draw on the GPU,
           which that window hides. -->
      <Shortcut Id="SafeGraphicsShortcut"
                Name="YumoCut (safe graphics)"
                Description="YumoCut, drawn in software"
                Target="[INSTALLFOLDER]concat.exe"
                Arguments="--software"
                WorkingDirectory="INSTALLFOLDER"
                Icon="yumocut.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\YumoCut" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
